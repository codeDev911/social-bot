# Canonical list of every environment variable this app understands.
# Copy to .env for local runs (never commit the filled-in file); on a host, set
# these in its secret store (fly secrets / Vercel / Render env settings).
# Never paste real secrets here — this file is committed to git.
# Keep it honest:
#   python scripts/env_keys.py           # .env vs this file
#   python scripts/env_keys.py --audit   # code vs this file

# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/socialbot?schema=public
PRISMA_PY_DEBUG_GENERATOR=0

# ── App ──────────────────────────────────────────────────────────────────────
APP_API_URL=http://localhost:8000
FRONTEND_URL=http://localhost:8000
INTERNAL_SECRET=change-me
MASTER_API_KEY=change-me
JWT_SECRET_KEY=change-me
REDIRECT_URI=http://localhost:8000/auth/callback
MAX_DISCOVERED_PER_RUN=2

# ── Cloudinary ───────────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Buffer ───────────────────────────────────────────────────────────────────
BUFFER_API_KEY=
BUFFER_CLIENT_ID=
BUFFER_CLIENT_SECRET=
BUFFER_REDIRECT_URI=

# ── Social providers ─────────────────────────────────────────────────────────
TIKTOK_CLIENT_ID=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── AI discovery bot ─────────────────────────────────────────────────────────
# USER_API_KEY is the per-user discovery token generated in the dashboard.
# It is required inside GitHub Actions, not by the web app.
USER_API_KEY=
GITHUB_DISPATCH_REPO=owner/repo
GITHUB_DISPATCH_TOKEN=

# ── Gemini (caption / hashtag generation) ────────────────────────────────────
GEMINI_API_KEY=

# ── Email (SMTP) ─────────────────────────────────────────────────────────────
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
EMAIL_ADDRESS=
EMAIL_PASSWORD=

# ── Downloads and proxies ────────────────────────────────────────────────────
DOWNLOAD_DIR=
# Oxylabs datacenter entrypoints (dc.*) are classified like cloud IPs. Use a
# residential pool (pr.oxylabs.io:7777:US) for YouTube/Instagram, or disable the
# proxy for platforms that punish it.
PROXY_USERNAME=
PROXY_PASSWORD=
PROXY_ENTRYPOINTS=
PROXY_SCHEME=http
# Username shape. Leave empty to let the downloader choose from the entrypoint:
#   dc.* host  -> user-{username}
#   anything else -> customer-{username}-country-{country}
# Tokens available: {username}, {country}. A wrong shape (or an expired plan) makes
# the proxy answer 407; the downloader then drops the proxy for the rest of that
# download instead of retrying it.
PROXY_USER_FORMAT=
# Comma-separated platforms that must bypass the proxy entirely (e.g. tiktok).
PROXY_DISABLE_PLATFORMS=
FORCE_IPV4=false
WEBSHARE_USERNAME=
WEBSHARE_PASSWORD=

# ── yt-dlp session cookies (all optional) ────────────────────────────────────
# Nothing is uploaded and no file is copied to the server: base64 the CONTENTS
# of a Netscape cookies.txt export and paste the single-line result as one env
# variable on the host.
#   Linux/macOS : base64 -w0 cookies.txt
#   PowerShell  : [Convert]::ToBase64String([IO.File]::ReadAllBytes("cookies.txt"))
# Leave a variable empty for any platform that is not blocking you — empty means
# "download without cookies". TikTok usually works anonymously; YouTube,
# Instagram and Facebook usually do not.
# YouTube additionally needs a JavaScript runtime to solve its signature/n
# challenges: Deno (installed in the Docker image), or Node >= 22 / Bun >= 1.2.11.
COOKIES_YOUTUBE_B64=
COOKIES_INSTAGRAM_B64=
COOKIES_FACEBOOK_B64=
COOKIES_TIKTOK_B64=
# Alternative to base64: point at a cookies.txt that already exists on disk. Takes
# precedence over the _B64 value. Easiest local setup (export once, point here).
COOKIES_YOUTUBE_FILE=
COOKIES_INSTAGRAM_FILE=
COOKIES_FACEBOOK_FILE=
COOKIES_TIKTOK_FILE=
# Optional: where the decoded cookie files are written (defaults to the OS temp
# dir). Leave empty in almost every case.
COOKIES_DIR=
# Optional: ffmpeg binary. Auto-detected from imageio-ffmpeg when empty.
FFMPEG_LOCATION=
YTDLP_SLEEP_REQUESTS=1
# JavaScript runtimes yt-dlp may use for YouTube challenges, in priority order.
# deno,node,bun — anything not installed is skipped automatically.
YTDLP_JS_RUNTIMES=deno,node,bun
YTDLP_EXTRA_OPTS=
# Verbose yt-dlp output. Turn on to confirm the PO token provider is answering:
# look for "PO Token Providers: bgutil:http" and "Generating a gvs PO Token".
YTDLP_VERBOSE=
# "Sign in to confirm you're not a bot" is scored per session and often clears on
# a fresh one. Only applies when no cookie is configured for that platform.
BOT_CHECK_RETRIES=1
BOT_CHECK_DELAY=30

# ── Download worker ──────────────────────────────────────────────────────────
# Set both to offload yt-dlp + Cloudinary uploads to worker_service.py.
# On Vercel this is mandatory: a serverless function cannot finish a download.
# WORKER_SERVICE_URL must be the https URL of the worker host; leave both empty
# only where the app itself runs as a long-lived server.
WORKER_SERVICE_URL=
WORKER_TOKEN=
WORKER_DISPATCH_TIMEOUT=30
WORKER_CALLBACK_PATH=/dashboard/api/worker/ingest
# How long the dashboard waits for the worker when painting queue phases.
WORKER_STATUS_TIMEOUT=3
# Vercel is detected automatically (VERCEL=1) and refuses to download in-process.
# Set true on any other host that must never fall back to a local download.
WORKER_REQUIRED=false
# Escape hatch: allow yt-dlp to run inside a serverless function anyway (the
# request will be killed at maxDuration). Leave empty in production.
ALLOW_VERCEL_DOWNLOAD=
# Bind address for `python worker_service.py` (hosts inject PORT themselves).
WORKER_HOST=0.0.0.0
PORT=
# PO token provider (bgutil), baked into Dockerfile.worker and started by
# worker_service.py. YouTube demands PO tokens from datacenter IPs; /health
# reports potProvider.running. Only change the port if 4416 is taken.
BGUTIL_SERVER_HOME=/opt/bgutil/server
BGUTIL_PROVIDER_PORT=4416
BGUTIL_PROVIDER_DISABLE=
# Injected by Vercel itself - never fill these in. The app reads them to know
# it is running serverless and must not download in-process.
VERCEL=
VERCEL_ENV=

# ── Third-party APIs ─────────────────────────────────────────────────────────
PEXEL_API_KEY=
PADDLE_API_KEY=
CRON_JOB_API_KEY=