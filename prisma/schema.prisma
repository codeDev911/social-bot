// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator py {
  provider             = "prisma-client-py"
  recursive_type_depth = 5
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Video {
  id                  Int             @id @unique @default(autoincrement())
  title               String          @default("")
  cloudinary_url      String          @default("")
  cloudinary_id       String
  upload_status       UploadStatus    @default(Pending)
  upload_id           String          @default("")
  upload_destination  UploadTargets   @default(Youtube) // remove this when wereset the DB
  upload_destinations UploadTargets[] @default([Youtube])
  captions            String          @default("")
  htags               String          @default("")
  scheduled_at        DateTime        @default(now())
  user                User            @relation(fields: [userId], references: [id])
  updatedAt           DateTime        @updatedAt
  userId              Int
  scrapedFrom     String?  @default("unkown")     // "tiktok" | "instagram" | etc
  externalId      String?    @default(cuid())   // Platform's native ID
  keywords        String[]     // Array of keywords/topics
  
  @@index([scrapedFrom])
  @@index([externalId])
  created_at          DateTime        @default(now())
}


model UserApiKey {
  id              Int       @id @default(autoincrement())
  userId          Int       
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  apiKey          String    @unique  // SHA256 hashed token
  raw_token       String?   // Store the raw token for one-time return (not hashed)
  name            String?   @default("Discover Service")// e.g., "Discovery Service"
  
  isActive        Boolean   @default(true)
  lastUsedAt      DateTime?
  createdAt       DateTime  @default(now())
  expiresAt       DateTime?
  
  @@index([apiKey])
  @@index([userId])
}

model userConfig {
  id     Int  @id @unique @default(autoincrement())
  userId Int  @unique
  user   User @relation(fields: [userId], references: [id])

  // User Preferences
  defaultCaption    String        @default("")
  defaultHtags      String        @default("")
  defaultUploadDest UploadTargets @default(Youtube)
  defaultUploadDests UploadTargets[] @default([Youtube])
  captionGenEnabled Boolean       @default(true)
  hashtagGenEnabled Boolean       @default(true)
  // Notification Preferences
  emailOnUpload     Boolean       @default(true)
  bufferApiKey     String        @default("")

  autoIngestEnabled Boolean @default(false)
  atuoIngestJson Json    @default("{}") // Store auto-ingest related settings as JSON (e.g., source platforms, filters, etc)

  // Scheduling
  scheduled   String @default("")
  scheduledId Int?
  timezone    String  @default("UTC")

  // Other User Settings
  theme    String @default("dark")
  language String @default("en")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  id             Int           @id @unique @default(autoincrement())
  fullname       String        @default("")
  email          String        @unique @default("")
  is_em_verif    Boolean       @default(false)
  videos         Video[]
  credentials    Json?
  avator         String?       @default("")
  account_status AccountStatus @default(Active)
  password       String
  createdAt      DateTime      @default(now())
  usage          Usage?
  updatedAt      DateTime
  plan           userPlan?
  userConfig     userConfig?
  dynamicEdits   DynamicEdit?
  userApiKey     UserApiKey[]
  aiDiscoveryConfig AiDiscoveryConfig?
}

model userPlan {
  id             Int          @id @unique @default(autoincrement())
  name           String?      @default("Free")
  type           UserPlanType @default(free)
  subscribtion   Json?
  trailStartedAt DateTime     @default(now())
  trailExpiredAt DateTime     @default(now())
  userId         Int          @unique
  user           User         @relation(fields: [userId], references: [id])
}

model Usage {
  id                Int      @id @unique @default(autoincrement())
  userId            Int      @unique
  user              User     @relation(fields: [userId], references: [id])
  uploadsToday      Int      @default(0)
  scheduledToday    Int      @default(0)
  connectedAccounts Int      @default(0)
  hTagRequests      Int      @default(0)
  captionRequests   Int      @default(0)
  credits           Int      @default(0)
  lastReset         DateTime @default(now())
}

model DynamicEdit {
  id     Int  @id @unique @default(autoincrement())
  userId Int  @unique
  user   User @relation(fields: [userId], references: [id])

  // Anti-copyright transformation config stored as JSON
  audioControls Json @default("{}")
  textOverlayControls Json @default("{}")
  pixelDistortionControls Json @default("{}")
  
  // Playground transformations config stored as JSON
  playgroundTransformations Json @default("{}")
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}


// ─────────────────────────────────────────────────────────────────────────────
// ADD THIS MODEL to your schema.prisma
// ─────────────────────────────────────────────────────────────────────────────

model AiDiscoveryConfig {
  id     Int  @id @unique @default(autoincrement())
  userId Int  @unique
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // ── Master toggle ────────────────────────────────────────────────────────
  isActive Boolean @default(false)

  // ── Search profiles ─────────────────────────────────────────────────────
  // [{ "query": "fifa 2026 highlights", "type": "keyword" }, ...]
  searchProfiles Json @default("[]")

  // ── Platform targeting ──────────────────────────────────────────────────
  enabledPlatforms UploadTargets[] @default([Youtube, Tiktok, Instagram, Facebook])

  // ── Filtering thresholds ────────────────────────────────────────────────
  minScore        Float @default(0.20)
  batchSize       Int   @default(10)
  maxPerPlatform  Int   @default(20)

  // ── Recency window: "day" | "week" | "month" | "year" ─────────────────
  timeFilter String @default("week")

  // ── Scheduling ───────────────────────────────────────────────────────────
  cronExpr   String    @default("0 */6 * * *")  // every 6 hours
  timezone   String    @default("UTC")
  lastRunAt  DateTime?
  nextRunAt  DateTime?

  // ── Run history / status (for dashboard display) ──────────────────────────
  lastRunStatus      String?  @default("idle")   // idle | running | success | failed
  lastRunVideoCount  Int      @default(0)
  lastRunTopVideoUrl String?
  lastRunViralVideoUrl String?
  lastRunError       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([nextRunAt, isActive])
}

