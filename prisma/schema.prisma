enum UserPlanType {
  free
  starter
  pro
}

enum AccountStatus {
  Active
  Suspended
  BlockedTemporary
}

enum UploadTargets {
  Youtube
  Tiktok
  Facebook
  Instagram
}

enum UploadStatus {
  Pending
  Failed
  Uploaded
  Deleted
}
