{
    "version": 2,
    "installCommand": "pip install -r requirements.txt && bash vercel-build.sh",
    "builds": [
        {
            "src": "main.py",
            "use": "@vercel/python",
            "config": { "maxDuration": 30 }
        }
    ],
    "routes": [
        {
            "src": "/(.*)",
            "dest": "main.py"
        }
    ]
}
